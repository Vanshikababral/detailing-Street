# ============================================
# DETAILING STREET LUDHIANA - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ── MongoDB Database ──────────────────────────────────────────
# MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/detailing_street?retryWrites=true&w=majority"

# ── Email / SMTP Configuration (Nodemailer) ───────────────────
# Use Gmail (with App Password) or custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="your-email@gmail.com"
ADMIN_NOTIFICATION_EMAIL="sarvottamchandel1509@gmail.com"

# ── Site Configuration ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://detailingstreetludhiana.com"
NEXT_PUBLIC_BUSINESS_PHONE="9115555035"
NEXT_PUBLIC_BUSINESS_EMAIL="sarvottamchandel1509@gmail.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/detailingstreet_modeltownlud"

# ── Optional ──────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACE_ID=""
